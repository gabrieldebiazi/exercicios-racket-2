#lang racket


;Exercício 1: ler um número inteiro e dizer se é negativo, zero ou positivo
(define (sinal)
  (display "Digite um número: ")
  (define num (read))
  (cond
    [(> num 0)
         "Positivo"]
    [(< num 0)
         "Negativo"]
    [else "Zero"]
    ))

;(sinal)

;Exercício 2: ler um número, se for maior que 20 retornar sua metade, se não retornar ele próprio
(define (maior20)
  (display "Digite um número: ")
  (define num(read))
  (if (> num 20) (/ num 2) num))

;(maior20)

;Exercício 3: ler um número e verificar se é par ou ímpar

(define (paridade)
  (display "Digite um número: ")
  (define num(read))
  (if (= (remainder num 2) 0) "Par" "Ímpar"))

;(paridade)

