;Exercício 7: Função matemática específica

(define (funcao)
  (display "Digite o valor da variável: ")
  (define x (read))
  
  (if (number? x)
      (cond
        [(<= x 1) 1]
        [(<= x 2) 2]
        [(<= x 3) (sqr x)]
        [else     (expt x 3)])
      
      (begin
        (displayln "Erro: Você deve digitar um número válido!")
        (funcao))))

;(funcao)

